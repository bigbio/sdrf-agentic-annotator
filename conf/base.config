/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
bigbio/sdrf-agentic-annotator base config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Runner image, resources, and the runner, model and retry settings of the agent tasks.
The agents and the plain processes use the same runner image, pinned by digest. To use a
local build, set `container` for the `process_single` label and `agent.container` in a custom config.
----------------------------------------------------------------------------------------
 */

process {
    cpus = 1
    memory = 2.GB
    time = 4.h

    resourceLimits = [cpus: 16, memory: 128.GB, time: 240.h]

    // Concurrent tasks per plain process. Agent tasks read only the `agent` scope below.
    maxForks = (params.max_parallel as Integer) > 0 ? (params.max_parallel as Integer) : 10

    withLabel: process_single {
        container = 'ghcr.io/bigbio/sdrf-agentic-annotator:dev@sha256:4d66cf91d990337bab85569beca8c2dc8f3d6b2ff61f4ec43e1adb992a16f9f5'
        cpus = 1
        memory = 2.GB
        time = 4.h
    }
}

agent {
    runner = 'pi'
    model = params.model
    apiProvider = params.api_provider
    apiKey = secrets.LLM_KEY
    container = 'ghcr.io/bigbio/sdrf-agentic-annotator:dev@sha256:4d66cf91d990337bab85569beca8c2dc8f3d6b2ff61f4ec43e1adb992a16f9f5'

    // pi retries overload errors (503) with these settings from <workdir>/.pi/settings.json.
    // It treats Gemini 429s as hard limits because their message says "quota exceeded" and "billing".
    beforeScript = 'mkdir -p .pi && echo \'{"retry":{"enabled":true,"maxRetries":6,"baseDelayMs":20000,"maxAgentDelayMs":120000}}\' > .pi/settings.json'

    // A per-minute 429 then fails the task, so Nextflow waits and starts the agent again from the beginning.
    // After the last retry the task is skipped and the other PXDs carry on, unless --fail_fast is set.
    errorStrategy = {
        if (task.attempt <= task.maxRetries) {
            sleep(90000L * task.attempt)
            return 'retry'
        }
        return params.fail_fast in [true, 'true'] ? 'terminate' : 'ignore'
    }
    maxRetries = 2

    // Nextflow creates the credentials of every agent task when it creates the task, but --max_parallel lets only a few run at
    // once. A task that waits longer than this for a free slot fails at once with "capability expired while the task waited
    // to start", and after its retries it is skipped. The default is one hour, so a batch larger than one hour of agent work
    // would lose its later PXDs.
    rpc.capabilityTimeout = '48h'

    // Concurrent tasks per agent process. Agent tasks read only this `agent` scope, not `process`.
    maxForks = (params.max_parallel as Integer) > 0 ? (params.max_parallel as Integer) : 10
}
