/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
bigbio/sdrf-agentic-annotator agent config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Runner, model and retry settings that apply to all agent tasks
----------------------------------------------------------------------------------------
 */

agent {
    runner = 'pi'
    model = params.model
    apiProvider = params.api_provider
    apiKey = secrets.LLM_KEY
    container = 'ghcr.io/bigbio/sdrf-agentic-annotator:dev'

    // pi retries overload errors (503) with these settings from <workdir>/.pi/settings.json.
    // It treats Gemini 429s as hard limits because their message says "quota exceeded" and "billing".
    beforeScript = 'mkdir -p .pi && echo \'{"retry":{"enabled":true,"maxRetries":6,"baseDelayMs":20000,"maxAgentDelayMs":120000}}\' > .pi/settings.json'

    // A per-minute 429 then fails the task, so Nextflow waits and starts the agent again from the beginning
    errorStrategy = {
        sleep(90000L * task.attempt)
        'retry'
    }
    maxRetries = 2

    // Concurrent tasks per agent process. Agent tasks read only this `agent` scope, not `process`.
    maxForks = (params.max_parallel as Integer) > 0 ? (params.max_parallel as Integer) : 10
}

/* Concurrent tasks per plain process (SDRF_COVERAGE). Together with agent.maxForks above,
--max_parallel reduces resource contention and provider rate limits on shared machines. */
process {
    maxForks = (params.max_parallel as Integer) > 0 ? (params.max_parallel as Integer) : 10
}
