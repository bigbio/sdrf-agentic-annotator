/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
bigbio/sdrf-agentic-annotator Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Default config options for all compute environments
----------------------------------------------------------------------------------------
 */

params {
    // Input/output options
    input = null
    outdir = null

    // Agent options
    model = 'google/gemini-3.5-flash-lite'
    api_provider = 'google'
    revise = true

    // Path to a user-supplied pi models.json registering any OpenAI-compatible gateway as a provider
    // (e.g. EBI's AI Gateway). When set, it is bind-mounted over /opt/pi-config/models.json in the
    // agent container, so EBI endpoint/tokens are never committed to the repo. See docker/models.json.
    models_json = null

    // Agents that fetch remote evidence files skip any single file larger than this many bytes
    // (e.g. a multi-GB MaxQuant msms.txt), and prefer smaller derived files (mqpar.xml, peptides,
    // modificationSpecificPeptides.txt, evidence.txt) over the full results/raw bundles.
    max_fetch_bytes = 524288000

    // Refine mode: take an already-published SDRF for each PXD (from the samplesheet's optional
    // `ref_sdrf` path, or fetched from bigbio/sdrf-annotated-datasets), refine it by seeded
    // re-annotation, and only accept the refined version if it is strictly better than the
    // baseline (verdict/confidence + coverage) on the same independent review.
    refine = false

    // A deterministic SDRF_COVERAGE step runs `sdrf-tools audit-existing` before each review. It
    // compares the SDRF's `comment[data file]` values with the deposited runs and reports the
    // `fraction` of runs that the SDRF annotates. When `coverage_min` (0..1) is > 0 and the
    // fraction is lower, the reviewer must treat it as an important finding unless the artifact
    // honestly declares itself a subset.
    coverage_min = 0.0
    // When true, permits a dataset to be annotated as a clearly-declared representative subset
    // (e.g. a huge DIA deposit) and accepted, instead of hard-failing on under-representation.
    subset_mode = false

    // The reviewer records a confidence 0..1 in each PASS. When a final PASS has confidence below
    // this threshold it is still accepted but flagged as LOW_CONF in summary.tsv. 0 = no gating.
    confidence_gate = 0.0

    // Maximum number of revise -> re-review rounds (0 to 2) a dataset may go through before the
    // final verdict is frozen.
    max_revise = 1

    // Maximum number of agent tasks (annotate/review/revise/refine) that run concurrently across
    // the whole batch. 0 = unlimited.
    max_parallel = 0

    // A dataset whose final review is FAIL is a content outcome, not an infrastructure error: the
    // pipeline publishes summary.tsv and completes normally. Set exit_on_review_fail = true to
    // exit non-zero when any dataset's final verdict is FAIL.
    exit_on_review_fail = false

    // Execution reports in <outdir>/pipeline_info
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Institutional configs from nf-core/configs
    custom_config_version = 'master'
    custom_config_base = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_name = null
    config_profile_description = null
    config_profile_contact = null
    config_profile_url = null
}

includeConfig 'conf/base.config'

// Load nf-core institutional profiles, unless offline
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)' + (params.models_json ? " -v ${params.models_json}:/opt/pi-config/models.json:ro" : '')
    }
    // HPC without root: run the pi agent runner under Singularity or Apptainer. Select ONE of
    // 'singularity' or 'apptainer' (not both) with, e.g. -profile singularity. The runner image
    // is an OCI image, so the first use pulls it from the registry and converts it to a SIF.
    // Point NXF_SINGULARITY_CACHEDIR / NXF_APPTAINER_CACHEDIR at a shared directory so every
    // compute node reuses the pull. Singularity runs as the invoking user already, so no uid
    // mapping is needed; autoMounts handles the home and work directories.
    singularity {
        singularity.enabled = true
        singularity.runOptions = params.models_json ? "-B ${params.models_json}:/opt/pi-config/models.json:ro" : ''
    }
    apptainer {
        apptainer.enabled = true
        apptainer.runOptions = params.models_json ? "-B ${params.models_json}:/opt/pi-config/models.json:ro" : ''
    }
    test {
        includeConfig 'conf/test.config'
    }
}

outputDir = params.outdir
workflow.output.mode = 'copy'
lineage.enabled = true

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

plugins {
    id 'nf-schema@2.8.0'
}

validation {
    defaultIgnoreParams = []
    monochromeLogs = false
    help {
        enabled = true
        command = "nextflow run bigbio/sdrf-agentic-annotator -profile docker --input samplesheet.csv --outdir <OUTDIR>"
    }
}

manifest {
    name = 'bigbio/sdrf-agentic-annotator'
    contributors = [[
        name: 'Jonas Scheid',
        affiliation: 'University of Tübingen',
        github: '@jonasscheid',
        contribution: ['author', 'maintainer'],
    ]]
    homePage = 'https://github.com/bigbio/sdrf-agentic-annotator'
    description = 'Annotate PRIDE datasets with SDRF using Nextflow agents and the bigbio/sdrf-skills'
    mainScript = 'main.nf'
    defaultBranch = 'main'
    nextflowVersion = '!>=26.10.3'
    version = '0.1.0dev'
    license = 'MIT'
}
