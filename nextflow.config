/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
jonasscheid/nf-agent-sdrf Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Default config options for all compute environments
----------------------------------------------------------------------------------------
 */

params {
    // Input/output options
    input = null
    outdir = null

    // Agent options
    model = 'google/gemini-3.5-flash-lite'
    api_provider = 'google'
    revise = true

    // Path to a user-supplied pi models.json registering any OpenAI-compatible gateway as a provider
    // (e.g. EBI's AI Gateway). When set, it is bind-mounted over /opt/pi-config/models.json in the
    // agent container, so EBI endpoint/tokens are never committed to the repo. See docker/models.json.
    models_json = null

    // Agents that fetch remote evidence files skip any single file larger than this many bytes
    // (e.g. a multi-GB MaxQuant msms.txt), and prefer smaller derived files (mqpar.xml, peptides,
    // modificationSpecificPeptides.txt, evidence.txt) over the full results/raw bundles.
    max_fetch_bytes = 524288000

    // ------------------------------------------------------------------
    // Coverage / subset disclosure (improvement 1)
    // ------------------------------------------------------------------
    // A deterministic SDRF_COVERAGE step compares every `comment[data file]` value in the SDRF
    // against the PRIDE deposit file list before review. It reports the matched/missing files and
    // the fraction of the deposit that the SDRF represents (coverage). When `coverage_min` (0..1)
    // is > 0 and the SDRF covers less than that fraction of the deposit's data files, the reviewer
    // must treat it as an important finding unless the artifact honestly declares itself a subset.
    coverage_min = 0.0
    // When true, permits a dataset to be annotated as a clearly-declared representative subset
    // (e.g. a huge DIA deposit) and accepted, instead of hard-failing on under-representation.
    subset_mode = false

    // ------------------------------------------------------------------
    // Confidence gating (improvement 2)
    // ------------------------------------------------------------------
    // The reviewer records a confidence 0..1 in each PASS. When a final PASS has confidence below
    // this threshold it is still accepted (kept and passed on to the next dataset) but flagged as
    // LOW_CONF in summary.tsv. 0 = no gating.
    confidence_gate = 0.0

    // ------------------------------------------------------------------
    // Bounded revise / escalation loop (improvement 3)
    // ------------------------------------------------------------------
    // Maximum number of revise -> re-review rounds a dataset may go through before the final
    // verdict is frozen. The current behaviour (one round) is kept when max_revise = 1.
    max_revise = 1

    // ------------------------------------------------------------------
    // Parallelism control (improvement 4)
    // ------------------------------------------------------------------
    // Maximum number of agent tasks (annotate/review/revise) that run concurrently across the
    // whole batch. 0 = unlimited (Nextflow default). Lowering this reduces per-task resource
    // contention on a shared machine at the cost of batch wall-clock time.
    max_parallel = 0

    // ------------------------------------------------------------------
    // Exit behaviour (improvement 5)
    // ------------------------------------------------------------------
    // The pipeline always publishes summary.tsv and completes normally for reproducible
    // content verdicts. A dataset whose final review is FAIL is a content outcome, not an
    // infrastructure error. Set exit_on_review_fail = true if you want the run to exit non-zero
    // when any dataset's final verdict is FAIL or LOW_CONF.
    exit_on_review_fail = false
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)' + (params.models_json ? " -v ${params.models_json}:/opt/pi-config/models.json:ro" : '')
    }
    test {
        includeConfig 'conf/test.config'
    }
}

outputDir = params.outdir
workflow.output.mode = 'copy'
lineage.enabled = true

plugins {
    id 'nf-schema@2.8.0'
}

validation {
    defaultIgnoreParams = []
    monochromeLogs = false
    help {
        enabled = true
        command = "nextflow run jonasscheid/nf-agent-sdrf -profile docker --input samplesheet.csv --outdir <OUTDIR>"
    }
}

manifest {
    name = 'jonasscheid/nf-agent-sdrf'
    contributors = [[
        name: 'Jonas Scheid',
        affiliation: 'University of Tübingen',
        github: '@jonasscheid',
        contribution: ['author', 'maintainer'],
    ]]
    homePage = 'https://github.com/jonasscheid/nf-agent-sdrf'
    description = 'Annotate PRIDE datasets with SDRF using Nextflow agents and the bigbio/sdrf-skills'
    mainScript = 'main.nf'
    defaultBranch = 'main'
    nextflowVersion = '!>=26.10.3'
    version = '0.1.0dev'
    license = 'MIT'
}
