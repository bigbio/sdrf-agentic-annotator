nextflow_workflow {

    name "Samplesheet parsing in refine mode"
    script "../subworkflows/local/utils_sdrf_agent/main.nf"
    workflow "PIPELINE_REFINE_INITIALISATION"
    tag "unit"

    test("ref_sdrf is optional per row") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def sheet = file("${outputDir}/refine.csv")
                sheet.text = 'pxd,ref_sdrf\\nPXD074155,${baseDir}/tests/data/PXD074155.sdrf.tsv\\nPXD058436,\\n'
                input[0] = sheet.toString()
                """
            }
        }

        then {
            def rows = workflow.out.rows.collectEntries { r -> [r.pxd, r.ref_sdrf] }
            assertAll(
                { assert workflow.success },
                { assert rows.keySet() == ['PXD074155', 'PXD058436'] as Set },
                { assert rows.PXD074155.endsWith('tests/data/PXD074155.sdrf.tsv') },
                { assert rows.PXD058436 == null }
            )
        }
    }

    test("a pxd-only samplesheet fetches every baseline") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = "${baseDir}/assets/samplesheet.csv"
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.rows.size() == 1 },
                { assert workflow.out.rows[0].pxd == 'PXD074155' },
                { assert workflow.out.rows[0].ref_sdrf == null }
            )
        }
    }
}
