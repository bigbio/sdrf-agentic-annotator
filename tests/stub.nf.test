nextflow_pipeline {

    name "Test pipeline with -stub"
    script "../main.nf"
    tag "stub"
    options "-stub"

    test("-profile test -stub") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def summary = path("$outputDir/summary.tsv").readLines()
            assertAll(
                { assert workflow.success },
                { assert summary == [
                    'pxd\tinitial_verdict\tfinal_verdict\trevised\tconfidence\tcoverage',
                    'PXD074155\tFAIL\tPASS\ttrue\t0.9\t1.0',
                ] },
                { assert path("$outputDir/PXD074155/PXD074155.sdrf.tsv").exists() },
                { assert path("$outputDir/PXD074155/PXD074155.review.json").exists() },
                { assert path("$outputDir/PXD074155/PXD074155.coverage.json").exists() },
                { assert path("$outputDir/PXD074155/revised/PXD074155.review.json").exists() },
                { assert path("$outputDir/pipeline_info/software_versions.yml").exists() }
            )
        }
    }

    test("-profile test -stub --max_revise 2") {

        when {
            params {
                max_revise = 2
                outdir = "$outputDir"
            }
        }

        then {
            def summary = path("$outputDir/summary.tsv").readLines()
            assertAll(
                { assert workflow.success },
                { assert summary[1] == 'PXD074155\tFAIL\tPASS\ttrue\t0.9\t1.0' },
                { assert workflow.trace.tasks().count { t -> t.name.contains('SDRF_REVISE_STUB') } == 2 }
            )
        }
    }

    test("-profile test -stub --refine") {

        when {
            params {
                input = "${projectDir}/tests/data/samplesheet_refine.csv"
                refine = true
                outdir = "$outputDir"
            }
        }

        then {
            def summary = path("$outputDir/refine_summary.tsv").readLines()
            assertAll(
                { assert workflow.success },
                { assert summary == [
                    'pxd\tbaseline_verdict\trefined_verdict\tchosen\tbaseline_coverage\trefined_coverage\tbaseline_confidence\trefined_confidence',
                    'PXD000001\tFAIL\tPASS\trefined\t1.0\t1.0\t0.9\t0.9',
                ] },
                { assert path("$outputDir/PXD000001/PXD000001.refine_verdict.json").json.chosen == 'refined' }
            )
        }
    }
}
