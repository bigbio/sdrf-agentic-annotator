nextflow_workflow {

    name "Test workflow PIPELINE_COMPLETION"
    script "subworkflows/local/utils_sdrf_agent/main.nf"
    workflow "PIPELINE_COMPLETION"
    tag "unit"

    test("refine mode: a kept baseline that passes is a final PASS") {

        when {
            params {
                exit_on_review_fail = true
            }
            workflow {
                """
                input[0] = channel.of(file("${projectDir}/tests/data/refine_summary.tsv"))
                """
            }
        }

        then {
            assert workflow.success
        }
    }

    test("annotate mode: a final FAIL stops the run with --exit_on_review_fail") {

        when {
            params {
                exit_on_review_fail = true
            }
            workflow {
                """
                input[0] = channel.of(file("${projectDir}/tests/data/summary_fail.tsv"))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { line -> line.contains('PXD000001') } }
            )
        }
    }
}
