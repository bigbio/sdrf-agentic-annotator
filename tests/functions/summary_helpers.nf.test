nextflow_function {

    name "Test the summary helpers"
    script "subworkflows/local/utils_sdrf_agent/main.nf"
    tag "unit"

    test("verdictOf reads the verdict") {
        function "verdictOf"
        when {
            function {
                """
                input[0] = file("${projectDir}/tests/data/review_fail.json")
                """
            }
        }
        then {
            assert function.result == 'FAIL'
        }
    }

    test("confidenceOf reads the confidence") {
        function "confidenceOf"
        when {
            function {
                """
                input[0] = file("${projectDir}/tests/data/review_pass.json")
                """
            }
        }
        then {
            assert Math.abs(function.result - 0.9) < 1e-6
        }
    }

    test("confidenceOf gives -1 without a confidence") {
        function "confidenceOf"
        when {
            function {
                """
                input[0] = file("${projectDir}/tests/data/review_no_confidence.json")
                """
            }
        }
        then {
            assert function.result == -1.0
        }
    }

    test("coverageOf gives the fraction") {
        function "coverageOf"
        when {
            function {
                """
                input[0] = file("${projectDir}/tests/data/coverage.json")
                """
            }
        }
        then {
            assert function.result == '1.0'
        }
    }

    test("coverageOf gives unverifiable for a coverage error") {
        function "coverageOf"
        when {
            function {
                """
                input[0] = file("${projectDir}/tests/data/coverage_error.json")
                """
            }
        }
        then {
            assert function.result == 'unverifiable'
        }
    }

    test("coverageOf gives n/a without a coverage file") {
        function "coverageOf"
        when {
            function {
                """
                input[0] = null
                """
            }
        }
        then {
            assert function.result == 'n/a'
        }
    }
}
